{
	"info": {
		"_postman_id": "nboard-api-collection-2026",
		"name": "Nboard API Collection - NSBM University Project",
		"description": "Complete API collection for Nboard - Student Boarding Management Platform\n\nThis collection includes all API endpoints for:\n- User authentication and registration\n- Property listings and management\n- Booking/Visit request system\n- Admin operations (owner and property approval)\n\nDeveloped as university project by eptheekshana\nInstitution: NSBM Green University\nYear: 2026\n\nDatabase: DigitalOcean MySQL\nStorage: DigitalOcean Spaces\n\nNote: This is a web-based application using Thymeleaf templates. Most endpoints return HTML views, not JSON responses.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
