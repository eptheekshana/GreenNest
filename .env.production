# =============================================================================
# NBOARD - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: Set these values in your production environment!
# Do NOT commit actual credentials to version control!
# =============================================================================

# --- DATABASE CONFIGURATION (Production) ---
DATABASE_URL=jdbc:mysql://<PROD_DB_HOST>:3306/<PROD_DB_NAME>
DATABASE_USERNAME=<PROD_DB_USER>
DATABASE_PASSWORD=<PROD_DB_PASSWORD>
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# --- SENDGRID EMAIL CONFIGURATION (Production) ---
# Set your production SendGrid API key
SENDGRID_API_KEY=<YOUR_SENDGRID_API_KEY>
# Verified sender domain/email in SendGrid
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Nboard
SENDGRID_DATA_RESIDENCY=eu

# --- APPLICATION SETTINGS ---
PORT=8080
APP_BASE_URL=https://yourdomain.com

# --- SESSION CONFIGURATION ---
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=true

# --- FILE STORAGE CONFIGURATION ---
FILE_STORAGE_MODE=cloud
FILE_UPLOAD_DIR=uploads

# --- DIGITALOCEAN SPACES (Production) ---
DO_SPACES_KEY=<YOUR_DO_SPACES_KEY>
DO_SPACES_SECRET=<YOUR_DO_SPACES_SECRET>
DO_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=nboard

# --- JWT CONFIGURATION ---
# Generate a strong secret: Use OpenSSL or online generator
JWT_SECRET=<GENERATE_STRONG_SECRET_HERE>
JWT_EXPIRATION_MS=86400000

